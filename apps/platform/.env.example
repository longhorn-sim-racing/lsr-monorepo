#Supabase (local values come from `npx supabase status -o env`)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
#Server only, never NEXT_PUBLIC: Jack broadcasts to his private Realtime room channels with it (SERVICE_ROLE_KEY in `supabase status -o env`)
SUPABASE_SERVICE_ROLE_KEY=""
#Supabase connection pooling + direct (for migrations)
DATABASE_URL=""
DIRECT_URL=""
#Jack's read-only SQL role (jack_readonly), for run_sql and describe_schema. Locally: `tsx scripts/jack-local-sql-role.ts` prints it.
#Production: the transaction pooler with the role's own username, jack_readonly.<project-ref>, and ?pgbouncer=true.
#Give the role a URL-safe (base64url) password; see docs/jack.md
JACK_DATABASE_URL=""

#Site base URL for links and redirects (check-in QR codes, emails, Stripe return, sign-in)
#Don't leave it as an empty string; delete the line instead to fall back to the browser origin / VERCEL_URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

#Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""
# Server-side uploads (the Instagram sync, scripts/gallery-import.ts) and video uploads in Admin -> Hotlap and clips
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

#Instagram (the access token is pasted in Admin -> Instagram, not set here; see docs/instagram.md)
# INSTAGRAM_GRAPH_URL="http://127.0.0.1:4555"  # only to point the sync at a stand-in API locally

#Shopify
SHOPIFY_STORE_DOMAIN=""
SHOPIFY_STOREFRONT_ACCESS_TOKEN=""
SHOPIFY_STOREFRONT_API_VERSION=""
NEXT_PUBLIC_SHOP_ENABLED=""

#Notifications
CRON_SECRET=""
RESEND_API_KEY=""
# Resend's daily email limit (100 on the free plan); "none" for a plan without one
# RESEND_DAILY_LIMIT=100
# Where replies to recruiting emails go (their Reply-To). Every decision email says "just reply", and the
# interview email without a booking link depends on it, so set it in production (e.g. recruiting@yourclub.org).
# Unset, replies go to the noreply address and nobody sees them.
RECRUITING_REPLY_TO=""

#Stripe (test-mode keys locally; see docs/payments.md)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
#Only for scripts/payments-smoke.ts (sk_test_...); the app never reads it
STRIPE_TEST_SECRET_KEY=""

#Jack (officer chat agent, see docs/jack.md). Without the key, Jack answers that he isn't connected yet
ANTHROPIC_API_KEY=""
# What Jack may spend on Claude per calendar month (Central Time) before he stops answering; default 200
# JACK_MONTHLY_BUDGET_USD=50
