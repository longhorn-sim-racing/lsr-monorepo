#Supabase (local values come from `npx supabase status -o env`)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
#Server only, never NEXT_PUBLIC: Jack broadcasts to his private Realtime room channels with it, and it's the key for
#his Supabase Storage file store in production. Locally: recommended (SERVICE_ROLE_KEY in `supabase status -o env`)
SUPABASE_SERVICE_ROLE_KEY=""
#Supabase connection pooling + direct (for migrations)
DATABASE_URL=""
DIRECT_URL=""
#Jack's read-only SQL role (jack_readonly), for run_sql, describe_schema and the eval. Locally: `tsx scripts/jack-local-sql-role.ts` prints it
#(it resets the password for every worktree on this machine; copy another worktree's line if one has it).
#Production: the transaction pooler with the role's own username, jack_readonly.<project-ref>, and ?pgbouncer=true.
#Give the role a URL-safe (base64url) password; see docs/jack.md
JACK_DATABASE_URL=""

#Site base URL for links and redirects (check-in QR codes, emails, Stripe return, sign-in)
#Don't leave it as an empty string; delete the line instead to fall back to the browser origin / VERCEL_URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

#Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""
# Server-side uploads (the Instagram sync, scripts/gallery-import.ts) and video uploads in Admin -> Hotlap and clips
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

#Instagram (the access token is pasted in Admin -> Instagram, not set here; see docs/instagram.md)
# Only to point the Instagram clients at a stand-in API locally: http on this machine only, ignored on Vercel production
# INSTAGRAM_GRAPH_URL="http://127.0.0.1:4555"

#Shopify
SHOPIFY_STORE_DOMAIN=""
SHOPIFY_STOREFRONT_ACCESS_TOKEN=""
SHOPIFY_STOREFRONT_API_VERSION=""
NEXT_PUBLIC_SHOP_ENABLED=""

#Notifications
CRON_SECRET=""
RESEND_API_KEY=""
# Resend's daily email limit (100 on the free plan); "none" for a plan without one
# RESEND_DAILY_LIMIT=100
# Where replies to recruiting emails go (their Reply-To). Every decision email says "just reply", and the
# interview email without a booking link depends on it, so set it in production (e.g. recruiting@yourclub.org).
# Unset, replies go to the noreply address and nobody sees them.
RECRUITING_REPLY_TO=""

#Stripe (test-mode keys locally; see docs/payments.md)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
#Only for scripts/payments-smoke.ts (sk_test_...); the app never reads it
STRIPE_TEST_SECRET_KEY=""

#Jack (officer chat agent, see docs/jack.md; local setup in docs/local-dev.md, "Jack locally")
#Without the key, Jack answers that he isn't connected yet. Locally: only for real (paid) answers
ANTHROPIC_API_KEY=""
# What Jack may spend on Claude per calendar month (Central Time) before he stops answering; default 50. Locally: optional
# JACK_MONTHLY_BUDGET_USD=50
# What automations (recurring questions, the weekly digest's summary) may spend of it per month; default 10. Locally: optional
# JACK_AUTOMATION_BUDGET_USD=10
# "on" gives Jack web search and fetch (the Anthropic Console must allow them too, or every reply fails); off when unset.
# Locally: leave unset unless testing them (paid)
# JACK_WEB_TOOLS=
# Local only: "all" (or a list like discord,twitch) points Jack's connector clients at the fakes
# from `pnpm jack:fakes` (docs/jack-2/tracks/groundwork.md). Ignored on Vercel production. The app's own email
# needs RESEND_BASE_URL below as well, and checkout Stripe isn't faked
# JACK_FAKES=
# Local only: where `pnpm jack:fakes` listens; http on this machine only. Default http://127.0.0.1:3999
# JACK_FAKES_URL=
# Local only: http://127.0.0.1:3999/resend sends the app's email to the Resend fake (the SDK reads it once, at load)
# RESEND_BASE_URL=
# Local only, optional: the Chrome or Chromium that renders slides, when Chrome or Edge isn't found
# JACK_CHROME_PATH=

#Jack 2.0 outside services (docs/jack-2/design.md, sections 12 and 15). All optional: a missing one shows as
#"missing: ..." on System -> Connections and its tools say it isn't connected. Server only; never NEXT_PUBLIC_.
#Locally none of them is needed: to try one, use its fake's made-up values (each docs/jack-2/tracks/ doc's
#"Trying it locally") with JACK_FAKES, never real keys.

#Jack's file store (deck renders, exports, screenshots, room files)
#Room files and deck renders go to Supabase Storage with SUPABASE_SERVICE_ROLE_KEY above (private bucket "jack";
#`tsx scripts/jack-storage-setup.ts` creates it) when the Supabase URL is a hosted project. With local Supabase
#(127.0.0.1) they go to .jack-renders/ on disk ("files"; room uploads then go through a local route) unless this
#says "supabase" (needs the bucket; see docs/jack-2/tracks/files.md). "blob" picks Vercel Blob (decks only).
#Locally: leave unset
# JACK_FILE_STORE=
# Vercel Blob, the fallback store for decks: Vercel sets BLOB_STORE_ID when a store is connected (used with its
# OIDC token); BLOB_READ_WRITE_TOKEN works instead. Locally: not needed
# BLOB_STORE_ID=
# BLOB_READ_WRITE_TOKEN=

#Scheduler (pg_cron calls /api/cron/tick when a job is due)
# Signs each call; the same value goes in Supabase Vault as lsr_scheduler_secret. Separate from CRON_SECRET.
# Locally: only for `pnpm jack:tick --http` (any random hex; the dev server reads the same .env.local)
# SCHEDULER_SIGNING_SECRET=
# The previous signing secret, still accepted while rotating. Locally: not needed
# SCHEDULER_SIGNING_SECRET_PREVIOUS=

#Discord (the club's Discord app)
# The bot's token: reads channel activity and polls, posts approved announcements
# DISCORD_BOT_TOKEN=
# The app's id (Developer Portal -> General Information), for the bot's install link. The app doesn't read it;
# it's the same value as DISCORD_CLIENT_ID
# DISCORD_APPLICATION_ID=
# The club server's id
# DISCORD_GUILD_ID=
# OAuth2 client id (the Application ID), for members linking their Discord account (identify scope only)
# DISCORD_CLIENT_ID=
# OAuth2 client secret, for the same (also keys the short-lived cookie that carries a link attempt's state)
# DISCORD_CLIENT_SECRET=
# Where Discord sends members back after linking. Default: <site URL>/api/discord/oauth/callback; register it
# in the Developer Portal (OAuth2 -> Redirects)
# DISCORD_OAUTH_REDIRECT_URI=

#Twitch (the club's Twitch developer app; its OAuth redirect URL is <site>/api/admin/twitch/callback, see docs/jack-2/tracks/sources-b.md)
# The app's client id
# TWITCH_CLIENT_ID=
# The app's client secret (app access token)
# TWITCH_CLIENT_SECRET=
# The club channel's numeric user id
# TWITCH_BROADCASTER_ID=
# Signs the EventSub stream.online and stream.offline webhooks to /api/webhooks/twitch
# TWITCH_EVENTSUB_SECRET=

#Stripe, read-only for Jack
# A restricted key (rk_...): Read on Balance, Payouts, Charges and Disputes, everything else None, every write off.
# rk_live_ only in production; rk_test_ elsewhere
# STRIPE_READONLY_KEY=

#Resend delivery events
# Signing secret of the webhook to /api/webhooks/resend
# RESEND_WEBHOOK_SECRET=

#Site traffic (Vercel Web Analytics, read by a daily snapshot job)
# Project-scoped token with a short expiry (Vercel has no read-only token; only the snapshot job uses it)
# VERCEL_ANALYTICS_TOKEN=
# The project's id (prj_...)
# VERCEL_ANALYTICS_PROJECT_ID=

#Instagram insights and publishing use tokens saved in Admin -> Instagram (SystemSetting), not env vars

#Google Drive (a service account with drive.readonly)
# The service account's JSON key, on one line
# GOOGLE_SERVICE_ACCOUNT_JSON=
# The shared root folder's id; files outside it are ignored
# GOOGLE_DRIVE_FOLDER_ID=

#Microsoft Teams and SharePoint (off until UT IT approves the app)
# The UT tenant's id
# MS_TENANT_ID=
# The app registration's client id
# MS_CLIENT_ID=
# The app registration's client secret
# MS_CLIENT_SECRET=
# The club team's id
# MS_TEAM_ID=
# The SharePoint site's id (granted through Sites.Selected)
# MS_SITE_ID=
# The document library's drive id on that site
# MS_DRIVE_ID=
# The Teams channels to sync, comma-separated
# MS_CHANNEL_IDS=
# Random secret Graph sends back with change notifications, checked on /api/webhooks/graph
# MS_GRAPH_CLIENT_STATE=
# Teams Workflows webhook for the weekly digest (the URL is itself a secret)
# TEAMS_WEBHOOK_URL=
