// ---------- Generators & Datasource ----------
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Enums ----------
enum EventStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  POSTPONED
}

enum UserStatus {
  active
  pending_verification
  retired
  deleted
}

enum Visibility {
  public
  members
  officers
}

enum EventType {
  meeting
  practice
  race
  workshop
  social
}

// Replaced RSVPStatus with RegistrationStatus
enum RegistrationStatus {
  REGISTERED
  WAITLISTED
  NOT_ATTENDING
}

enum CheckinMethod {
  QR
  MANUAL
}

enum AttendanceReportingMode {
  ASSUME_REGISTERED
  CHECKIN_REQUIRED
}

enum PaymentProvider {
  stripe
  manual
  other
}

enum PaymentStatus {
  succeeded
  pending
  failed
  refunded
}

enum ProductType {
  ANNUAL_DUES
  LEAGUE_FEE
  EVENT_FEE
}

enum EntitlementKind {
  lsr_member
  league_access
}

enum EntitlementScope {
  year
  season
  lifetime
}

enum SimExperience {
  NONE
  CASUAL
  SIM_RACER
  COMPETITIVE
}

enum RacingEquipment {
  WHEEL
  PEDALS
  CONTROLLER
  KEYBOARD
}

enum LeagueApplicationSource {
  SITE
  ADMIN
  GOOGLE_FORM
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

// ---------- Identity & Access ----------
model User {
  id                 String     @id @default(uuid())
  email              String     @unique
  handle             String     @unique
  displayName        String
  avatarUrl          String?
  bio                String?
  iRating            Int?
  socials            Json?
  officerTitle       String?
  racingNumber       Int?       @unique
  racingNumberColor  String     @default("#FFFFFF")
  racingNumberFont   String     @default("sans-serif")
  racingNumberItalic Boolean    @default(false)
  racingNumberBorder Boolean    @default(false)
  marketingOptIn     Boolean    @default(true)
  status             UserStatus @default(active)

  major      String?
  gradYear   Int?
  eid        String?  @unique
  signedUpAt DateTime @default(now())

  /// Officer profile (Jack 2.0, #188): the officer's team (the about page roster's TeamId:
  /// executive, business, community, competition, media, technology), whether they hold a board seat,
  /// and a short "what I work on". Jack tailors explanations to it; facts never change with it
  department String?
  isBoard    Boolean @default(false)
  workingOn  String? @db.VarChar(160)

  /// The member's linked Discord account (Jack 2.0): set through Discord OAuth from their profile.
  /// No Discord tokens are kept
  discordUserId   String?   @unique
  discordUsername String?
  discordLinkedAt DateTime?

  // Relations
  roles                UserRole[]
  payments             Payment[]
  entitlements         Entitlement[]
  memberships          UserMembership[]
  posts                Post[]              @relation("PostAuthor")
  pages                Page[]              @relation("PageAuthor")
  registrations        EventRegistration[] // Renamed from RSVPs
  attendances          EventAttendance[]   @relation("UserAttendance")
  checkedInAttendances EventAttendance[]   @relation("AttendanceChecker")
  entries              Entry[]             @relation("EntryUser")

  auditLogs          AuditLog[]          @relation("AuditActor")
  auditLogsTargeted  AuditLog[]          @relation("AuditTarget")
  rawResultUploads   RawResultUpload[]
  driverIdentities   DriverIdentity[]
  raceParticipants   RaceParticipant[]
  leagueApplications LeagueApplication[]

  // Recruiting relations
  applications             Application[]       @relation("ApplicationApplicant")
  decidedApplicationTracks ApplicationTrack[]  @relation("ApplicationDecider")
  applicationReviews       ApplicationReview[] @relation("ApplicationReviewer")

  // Notification relations
  notifications     Notification[]
  notificationPrefs NotificationPreference?

  // Jack (officer chat agent)
  jackRoomsCreated JackRoom[]        @relation("JackRoomCreator")
  jackMessages     JackMessage[]     @relation("JackMessageAuthor")
  jackDecks        JackDeck[]        @relation("JackDeckCreator")
  jackDeckVersions JackDeckVersion[] @relation("JackDeckVersionAuthor")

  // Jack 2.0 (#188)
  knowledgeOwned     KnowledgeEntry[]    @relation("KnowledgeOwner")
  actionItemsOwned   ActionItem[]        @relation("ActionItemOwner")
  prospectsOwned     SponsorProspect[]   @relation("SponsorProspectOwner")
  recurringQuestions RecurringQuestion[] @relation("RecurringQuestionCreator")
  jackFeedback       JackFeedback[]
  discordMembers     DiscordMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id          String @id @default(uuid())
  key         String @unique // "admin" | "officer" | "member"
  description String

  users UserRole[]
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([userId, roleId])
  @@index([roleId])
}

model AuditLog {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now())
  actorUserId  String?
  actionType   String
  entityType   String
  entityId     String
  targetUserId String?

  summary  String
  before   Json?
  after    Json?
  metadata Json?

  requestId String?
  ip        String?
  userAgent String?

  actor      User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  targetUser User? @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([actionType, createdAt])
}

// ---------- Membership, Dues & Fees ----------
model MembershipTier {
  id    String @id @default(uuid())
  key   String @unique // "GENERAL", "LSR_MEMBER"
  label String

  users UserMembership[]
}

model UserMembership {
  id        String    @id @default(uuid())
  userId    String
  tierId    String
  validFrom DateTime
  validTo   DateTime?

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier MembershipTier @relation(fields: [tierId], references: [id], onDelete: Cascade)

  @@unique([userId, tierId, validFrom])
  @@index([userId, validTo])
}

model Product {
  id          String      @id @default(uuid())
  type        ProductType
  name        String
  leagueId    String?
  amountCents Int
  currency    String      @default("USD")
  active      Boolean     @default(true)
  metadata    Json?

  league   League?   @relation("EntitlementLeague", fields: [leagueId], references: [id], onDelete: SetNull) // named to match Entitlement.league
  payments Payment[]

  @@unique([type, leagueId])
  @@index([leagueId])
}

model Payment {
  id          String          @id @default(uuid())
  userId      String
  productId   String?
  amountCents Int
  currency    String          @default("USD")
  provider    PaymentProvider
  providerRef String?
  status      PaymentStatus
  paidAt      DateTime?
  metadata    Json?
  createdAt   DateTime        @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: Restrict)

  entitlements      Entitlement[]
  eventRegistration EventRegistration? // 1:1 back-relation for event fee payments

  @@index([userId, productId, status, paidAt])
}

model Entitlement {
  id              String           @id @default(uuid())
  userId          String
  kind            EntitlementKind
  leagueId        String?
  scope           EntitlementScope
  validFrom       DateTime
  validTo         DateTime?
  sourcePaymentId String?
  meta            Json?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  league  League?  @relation("EntitlementLeague", fields: [leagueId], references: [id], onDelete: SetNull) // <-- named & back-rel on League
  payment Payment? @relation(fields: [sourcePaymentId], references: [id], onDelete: SetNull)

  @@index([userId, kind, leagueId, validTo])
  @@index([leagueId])
}

// ---------- Leagues & Competition ----------
model League {
  id            String     @id @default(uuid())
  name          String
  slug          String     @unique
  descriptionMd String?
  visibility    Visibility @default(public)

  seasons      Season[]
  products     Product[]     @relation("EntitlementLeague")
  entitlements Entitlement[] @relation("EntitlementLeague") // <-- back-relation
}

model Season {
  id         String     @id @default(uuid())
  leagueId   String?
  seriesId   String?
  name       String
  slug       String     @unique
  year       Int
  startAt    DateTime?
  endAt      DateTime?
  pointsRule Json?
  visibility Visibility @default(public)

  league       League?             @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  series       EventSeries?        @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  entries      Entry[]
  applications LeagueApplication[]

  @@index([leagueId, year])
  @@index([seriesId])
}

// A driver's entry form for one league season (replaces the comp team's Google Form).
// Whether they've paid lives on their league_access Entitlement, not here.
model LeagueApplication {
  id              String                  @id @default(uuid())
  userId          String
  seasonId        String
  discordUsername String
  experience      SimExperience
  equipment       RacingEquipment[]
  canCommit       Boolean
  school          String? // null = UT Austin
  notes           String?
  source          LeagueApplicationSource @default(SITE)
  createdById     String? // the admin who backfilled it, when source isn't SITE
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([userId, seasonId])
  @@index([seasonId])
}

model Entry {
  id               String  @id @default(uuid())
  seasonId         String
  userId           String?
  number           Int?
  isEligiblePoints Boolean @default(true)

  // Aggregated Stats (Computed)
  totalPoints          Int    @default(0)
  totalCuts            Int    @default(0)
  totalCollisions      Int    @default(0)
  totalPositionsGained Int    @default(0)
  starts               Int    @default(0)
  wins                 Int    @default(0)
  podiums              Int    @default(0)
  top5                 Int    @default(0)
  top10                Int    @default(0)
  bestFinish           Int?
  averageFinish        Float?
  dnfs                 Int    @default(0)
  rank                 Int?

  carDisplay String?

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  user   User?  @relation("EntryUser", fields: [userId], references: [id], onDelete: SetNull)

  @@unique([seasonId, userId], map: "unique_entry_user")
  @@index([seasonId])
}

// ---------- Events ----------
model EventSeries {
  id         String     @id @default(uuid())
  title      String
  slug       String     @unique
  visibility Visibility @default(public)

  events    Event[]
  seasons   Season[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Venue {
  id            String  @id @default(uuid())
  name          String
  addressLine1  String?
  addressLine2  String?
  city          String?
  state         String?
  postalCode    String?
  country       String?
  room          String?
  googleMapsUrl String?
  appleMapsUrl  String?

  events    Event[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id           String  @id @default(uuid())
  seriesId     String?
  venueId      String?
  slug         String  @unique
  title        String
  roundNumber  Int?
  summary      String?
  description  String?
  heroImageUrl String?

  startsAtUtc DateTime
  endsAtUtc   DateTime
  timezone    String

  visibility Visibility  @default(public)
  status     EventStatus @default(DRAFT)

  // Registration Config (Renamed/New fields)
  registrationEnabled         Boolean   @default(false)
  registrationOpensAt         DateTime?
  registrationClosesAt        DateTime?
  registrationMax             Int?
  registrationWaitlistEnabled Boolean   @default(false)
  waitlistAutoPromote         Boolean   @default(true) // free events only; a paid waitlist is always promoted by an officer
  registrationFeeCents        Int? // null = free event; set to require Stripe payment

  // Attendance Config
  attendanceEnabled       Boolean                 @default(false)
  attendanceOpensAt       DateTime?
  attendanceClosesAt      DateTime?
  attendanceReportingMode AttendanceReportingMode @default(ASSUME_REGISTERED)

  // Removed old fields to avoid confusion: rsvpRequired, rsvpOpenAt, rsvpCloseAt, capacity, waitlistEnabled

  meetingUrl String?
  streamUrl  String?

  series EventSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  venue  Venue?       @relation(fields: [venueId], references: [id], onDelete: SetNull)

  registrations EventRegistration[] // Renamed from rsvps
  attendances   EventAttendance[]

  rawResultUploads RawResultUpload[]
  ingestedSessions RaceSession[]
  galleryAlbums    GalleryAlbum[]

  publishedAt DateTime?
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())

  @@index([startsAtUtc])
  @@index([status, startsAtUtc])
}

model EventRegistration {
  id              String             @id @default(uuid())
  eventId         String
  userId          String
  status          RegistrationStatus
  waitlistOrder   Int? // 1-based index for waitlist position
  promotedAt      DateTime?
  promotionSource String? // e.g. "manual", "auto"
  statusReason    String? // e.g. "Admin demote", "Capacity increase"
  sourcePaymentId String?            @unique // links to Payment for paid event registrations
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [sourcePaymentId], references: [id], onDelete: SetNull)

  @@unique([eventId, userId])
  @@index([eventId, status])
  @@index([eventId, status, waitlistOrder])
}

model EventAttendance {
  id                String        @id @default(uuid())
  eventId           String
  userId            String
  checkedInAt       DateTime      @default(now())
  method            CheckinMethod
  checkedInByUserId String?
  createdAt         DateTime      @default(now())

  event           Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user            User  @relation("UserAttendance", fields: [userId], references: [id], onDelete: Cascade)
  checkedInByUser User? @relation("AttendanceChecker", fields: [checkedInByUserId], references: [id], onDelete: SetNull)

  @@unique([eventId, userId])
  @@index([eventId, checkedInAt])
  @@index([eventId, userId])
}

// ---------- Content (light CMS) ----------
model Post {
  id            String     @id @default(uuid())
  title         String
  slug          String     @unique
  excerpt       String?
  bodyMd        String
  /// Cloudinary URL of the cover photo shown on /news and the article page
  coverImageUrl String?
  authorId      String? // <-- optional because onDelete: SetNull
  publishedAt   DateTime?
  visibility    Visibility @default(public)

  author    User?    @relation("PostAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Page {
  id         String     @id @default(uuid())
  title      String
  slug       String     @unique
  bodyMd     String
  visibility Visibility @default(public)
  authorId   String?

  author    User?    @relation("PageAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tag {
  id   String @id @default(uuid())
  name String
  slug String @unique

  entities EntityTag[]
}

// NOTE: Prisma can’t enforce a polymorphic relation back to Post/Page/etc.
// Keep `entityType` + `entityId` as loose FKs and query manually.
model EntityTag {
  id         String @id @default(uuid())
  tagId      String
  entityType String // e.g. "post","page","event","league","season",...
  entityId   String

  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@index([tagId])
}

model FeatureFlag {
  id      String  @id @default(uuid())
  key     String  @unique
  enabled Boolean @default(false)
}

model GalleryImage {
  id         String        @id @default(uuid())
  publicId   String        @unique
  alt        String?
  creditName String?
  creditUrl  String?
  order      Int           @default(0)
  // Pixel size from Cloudinary, so the gallery can lay photos out before they load
  width      Int?
  height     Int?
  albumId    String?
  album      GalleryAlbum? @relation(fields: [albumId], references: [id], onDelete: SetNull)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([albumId, order])
}

/// A set of gallery photos from one shoot or event. Albums sort by date, newest first.
model GalleryAlbum {
  id          String         @id @default(uuid())
  slug        String         @unique
  title       String
  description String?
  date        DateTime?
  eventId     String?
  event       Event?         @relation(fields: [eventId], references: [id], onDelete: SetNull)
  images      GalleryImage[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([date])
}

enum RawResultUploadStatus {
  UPLOADED
  PARSED
  INGESTED
  FAILED
}

model RawResultUpload {
  id               String                @id @default(uuid())
  filename         String
  filesize         Int
  sha256           String
  rawJson          Json
  uploadedByUserId String
  uploadedAt       DateTime              @default(now())
  status           RawResultUploadStatus @default(UPLOADED)
  errorMessage     String?
  parseReport      ParseReport?

  uploadedBy   User    @relation(fields: [uploadedByUserId], references: [id])
  eventId      String?
  pointsSystem String? // "F1", "NONE"
  sessionLabel String? // "PRACTICE", "QUALIFYING", "RACE"
  event        Event?  @relation(fields: [eventId], references: [id])

  ingestedSessions RaceSession[]

  @@index([uploadedByUserId])
  @@index([eventId])
}

model DriverIdentity {
  id           String   @id @default(uuid())
  driverGuid   String   @unique
  lastSeenName String
  userId       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id])
}

model CarMapping {
  id                   String  @id @default(uuid())
  gameCarName          String  @unique
  displayName          String
  secondaryDisplayName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants RaceParticipant[]
}

model RaceSession {
  id       String  @id @default(uuid())
  uploadId String
  eventId  String?

  // Session details from JSON
  sessionType  String // "RACE", "QUALIFYING", "PRACTICE"
  trackName    String
  trackConfig  String?
  startedAt    DateTime
  pointsSystem String? // "F1", "NONE", etc.

  upload RawResultUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  event  Event?          @relation(fields: [eventId], references: [id])

  participants RaceParticipant[]
  results      RaceResult[]
  laps         RaceLap[]
  events       RaceEvent[]

  @@index([uploadId])
  @@index([eventId])
}

model RaceParticipant {
  id          String  @id @default(uuid())
  sessionId   String
  driverGuid  String
  displayName String
  carName     String
  carClass    String
  teamName    String?

  // New fields from "Cars"
  carIdInSession Int? // The "CarId" (0, 1, 2...)
  nation         String?
  skin           String?
  ballastKg      Int?
  restrictor     Int?

  session RaceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId  String?
  user    User?       @relation(fields: [userId], references: [id])

  carMappingId String?
  carMapping   CarMapping? @relation(fields: [carMappingId], references: [id])

  results RaceResult[]
  laps    RaceLap[]

  eventsAsPrimary RaceEvent[] @relation("EventPrimary")
  eventsAsOther   RaceEvent[] @relation("EventOther")

  @@unique([sessionId, driverGuid])
}

model RaceResult {
  id            String @id @default(uuid())
  sessionId     String
  participantId String

  position      Int
  classPosition Int
  bestLapTime   Int? // ms
  totalTime     Int? // ms
  lapsCompleted Int
  status        String // "Finished", "DNF", etc.
  gap           String?

  // New fields from "Result"
  points         Int?
  totalCuts      Int?
  collisionCount Int?
  penaltyTime    Int?
  lapPenalty     Int?
  isDisqualified Boolean @default(false)

  session     RaceSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  participant RaceParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model RaceLap {
  id            String @id @default(uuid())
  sessionId     String
  participantId String

  lapNumber Int
  lapTime   Int // ms
  sector1   Int? // ms
  sector2   Int? // ms
  sector3   Int? // ms
  valid     Boolean @default(true)

  // New fields from "Laps"
  cuts      Int?
  tyre      String?
  timestamp Int? // Session timestamp

  session     RaceSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  participant RaceParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([sessionId, participantId])
}

model RaceEvent {
  id        String @id @default(uuid())
  sessionId String
  type      String // "COLLISION_WITH_CAR", "COLLISION_WITH_ENV"

  carId         Int?
  driverGuid    String?
  participantId String?

  otherCarId         Int?
  otherDriverGuid    String?
  otherParticipantId String?

  impactSpeed Float

  worldPosX Float?
  worldPosY Float?
  worldPosZ Float?

  relPosX Float?
  relPosY Float?
  relPosZ Float?

  session          RaceSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  participant      RaceParticipant? @relation("EventPrimary", fields: [participantId], references: [id])
  otherParticipant RaceParticipant? @relation("EventOther", fields: [otherParticipantId], references: [id])

  @@index([sessionId])
}

model ParseReport {
  id           String   @id @default(uuid())
  uploadId     String   @unique
  drivers      Json
  resultsCount Int
  lapsCount    Int
  anomalies    String[]
  createdAt    DateTime @default(now())

  upload RawResultUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
}

// ---------- Notifications ----------
model Notification {
  id        String              @id @default(uuid())
  userId    String
  channel   NotificationChannel
  type      String // e.g., "REGISTRATION_CONFIRMED", "WAITLIST_PROMOTED"
  title     String
  body      String
  actionUrl String? // Link to navigate to
  metadata  Json? // Extra data (eventId, etc.)

  status       NotificationStatus @default(PENDING)
  scheduledFor DateTime? // Null = send immediately
  sentAt       DateTime?
  readAt       DateTime? // For in-app only
  dismissedAt  DateTime? // User dismissed/hid notification (soft delete)

  // For email tracking
  emailMessageId String? // Resend message ID
  emailError     String? // Error message if failed

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, channel, readAt])
  @@index([userId, channel, dismissedAt])
  @@index([status, scheduledFor])
  @@index([type, createdAt])
  @@index([emailMessageId])
}

model NotificationPreference {
  id     String @id @default(uuid())
  userId String @unique

  // Email notifications. New events and results also need marketingOptIn on User;
  // payment receipts ignore all of these (see notification.service.ts)
  emailRegistration      Boolean @default(true)
  emailWaitlistPromotion Boolean @default(true)
  emailEventReminder     Boolean @default(false) // Off by default
  emailEventPosted       Boolean @default(false) // Off by default
  emailResultsPosted     Boolean @default(false) // Off by default

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Posts copied from the club Instagram account by the sync job (src/server/services/instagram.service.ts).
/// The account's access token and sync status live in SystemSetting under "instagram".
model InstagramPost {
  id        String   @id // Instagram's media id
  permalink String
  caption   String?
  mediaType String // IMAGE, VIDEO or CAROUSEL_ALBUM
  /// Cloudinary copy of the photo (a video's cover frame), since Instagram's own image links expire
  publicId  String?
  width     Int?
  height    Int?
  postedAt  DateTime
  /// Officers can hide a post from the site without touching Instagram
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Insights (Jack 2.0): copied by the insights job, since Instagram only keeps some of them for a while
  reach      Int?
  likes      Int?
  comments   Int?
  saved      Int?
  shares     Int?
  views      Int?
  insightsAt DateTime?

  @@index([hidden, postedAt])
}

model SystemSetting {
  key       String   @id
  value     String // JSON-encoded value
  updatedAt DateTime @updatedAt
}

// ---------- Jack (officer chat agent, #161) ----------

/// Which model wrote a Jack message. Jack = Sonnet (every answer by default), Lift = Opus (hard
/// questions), Stand = Haiku (quick, simple questions when a room is set to it, and side jobs like
/// naming rooms)
enum JackPersona {
  jack
  lift
  stand
}

/// Which model answers in a room. A room setting rather than a per-message one, so the room's
/// prompt cache isn't thrown away by switching back and forth
enum JackRoomPersona {
  jack
  lift
  stand
}

/// Who a message is from: an officer (user), a model (assistant), or the room itself (system,
/// e.g. "Alex switched this room to Lift")
enum JackMessageKind {
  user
  assistant
  system
}

enum JackMessageStatus {
  streaming
  done
  error
}

/// A shared chat room in the admin console. Rooms aren't per user: every officer sees every room
/// and can post in it. Live text goes out over the private Realtime channel `jack:room:<id>`.
model JackRoom {
  id          String          @id @default(uuid())
  title       String?
  /// The model that answers here; officers switch it per room
  persona     JackRoomPersona @default(jack)
  /// Null once the officer who opened it deletes their account
  createdById String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  archivedAt  DateTime?

  /// The reply loop answering this room right now; one run per room at a time.
  /// Taken with a conditional update; a lock older than ~6 minutes is from a run that died
  /// and the next post (or "continue") takes it over (src/server/jack/room-lock.ts)
  runId        String?
  runStartedAt DateTime?

  /// Jack 2.0: pinned rooms sort first; in "mention" mode Jack answers only messages that mention him
  pinnedAt   DateTime?
  answerMode String    @default("always")

  createdBy          User?               @relation("JackRoomCreator", fields: [createdById], references: [id], onDelete: SetNull)
  messages           JackMessage[]
  usage              JackUsage[]
  decks              JackDeck[]
  proposals          JackProposal[]
  files              JackFile[]
  recurringQuestions RecurringQuestion[]
  meetings           Meeting[]

  @@index([archivedAt, updatedAt])
}

/// Claude calls whose cost isn't saved on a message: Stand's side jobs (naming a room), one row per
/// call whatever came of it (named, declined, unusable, the room already had a title). Replies keep
/// their cost on their own JackMessage row. The spend meter adds both up
model JackUsage {
  id              String      @id @default(uuid())
  /// Null once the room is deleted; the spend stays
  roomId          String?
  persona         JackPersona
  /// What the call was for, e.g. "name_room"
  job             String
  /// How it went, e.g. "named", "declined", "unusable", "already_titled"
  outcome         String
  model           String
  /// Everything not read from the cache, as on JackMessage
  inputTokens     Int
  outputTokens    Int
  cacheReadTokens Int
  costUsd         Decimal     @db.Decimal(12, 6)
  createdAt       DateTime    @default(now())

  room JackRoom? @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

/// One message in a room. `kind` says who it's from; a check constraint keeps `persona` set exactly
/// on assistant messages, and `authorUserId` off them
model JackMessage {
  id            String            @id @default(uuid())
  roomId        String
  kind          JackMessageKind
  /// user: the officer who wrote it. system: the officer whose action it records. Null for assistant
  /// messages, and once the officer deletes their account
  authorUserId  String?
  /// assistant: the model that wrote it. Null otherwise
  persona       JackPersona?
  content       String            @default("")
  /// Tool calls and their results (later steps)
  toolCalls     Json?
  status        JackMessageStatus @default(done)
  /// The last streamed delta whose text is saved in `content`. Viewers who open the room
  /// mid-answer apply only the deltas after it
  streamSeq     Int               @default(0)
  /// user messages: the reply that answered it. Null until Jack picks it up, so a message posted
  /// while he's answering waits for the next pass
  answeredById  String?
  /// A room note asking Jack to keep going (#177): a deck job that ran out of time or tool calls
  /// leaves one, and it's answered like an officer message (answeredById), as the officer it names
  continues     Boolean           @default(false)
  /// A room note a scheduled run posted (a recurring question, design §11.1). It's answered as the officer
  /// it names, in a reply of its own (never together with officer messages) that gets no web tools
  scheduled     Boolean           @default(false)
  /// Officer messages (Jack 2.0): who posted it as Jack reads it, from their profile when they posted it,
  /// e.g. "Gray (Technology Director · Technology · CS) [@gray-marshall]". Snapshotted so history never
  /// changes when a profile does
  authorLabel   String?
  /// False for officer messages in a mention-mode room that don't mention Jack: context, not questions
  expectsAnswer Boolean           @default(true)
  /// Notes a scheduled job posted (Jack 2.0 automation): the job's ScheduledJob.key, "recurring:<id>" for a
  /// recurring question or "digest.weekly" for the weekly digest. A scheduled reply's history is its own
  /// job's notes only (the question and its last answer, design §11.1), and the Recurring questions and
  /// Usage pages find a job's runs by it. A plain string: the notes keep it after the job is deleted
  jobKey        String?

  /// Assistant messages only (later steps)
  model           String?
  inputTokens     Int?
  outputTokens    Int?
  cacheReadTokens Int?
  costUsd         Decimal? @db.Decimal(12, 6)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  room         JackRoom          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  author       User?             @relation("JackMessageAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  answeredBy   JackMessage?      @relation("JackAnswer", fields: [answeredById], references: [id], onDelete: SetNull)
  answers      JackMessage[]     @relation("JackAnswer")
  /// Deck changes this reply made
  deckVersions JackDeckVersion[]
  files        JackFile[]
  feedback     JackFeedback[]

  @@index([roomId, createdAt])
  @@index([roomId, kind, answeredById])
  @@index([authorUserId])
  @@index([jobKey, createdAt])
}

/// A deck's canvas: 16:9 slides (1920x1080), an Instagram post (1080x1350), an Instagram story
/// (1080x1920) or a square post (1080x1080). Sizes live in src/lib/jack/decks.ts
enum JackDeckSize {
  slides
  post
  story
  square
}

/// A slide deck or social graphic Jack made in a room (#177). A graphic is a deck at a social size:
/// usually one slide, or several for a carousel. Its slides live in versions: every change saves a
/// new JackDeckVersion and moves `version` to it, so an officer can undo a change
model JackDeck {
  id          String       @id @default(uuid())
  title       String
  size        JackDeckSize
  /// The current JackDeckVersion.version
  version     Int          @default(1)
  /// The room it was made in. Null once the room is deleted
  roomId      String?
  /// The officer whose message started the reply that made it. Null once they delete their account
  createdById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  room      JackRoom?         @relation(fields: [roomId], references: [id], onDelete: SetNull)
  createdBy User?             @relation("JackDeckCreator", fields: [createdById], references: [id], onDelete: SetNull)
  versions  JackDeckVersion[]

  @@index([updatedAt])
  @@index([roomId])
}

/// One saved state of a deck, never changed once written. `content` is the deck's shared CSS and its
/// slides in order: { css, slides: [{ id, html, notes? }] } (JackDeckContent in src/lib/jack/decks.ts).
/// Undo restores an older version as a new one
model JackDeckVersion {
  id        String   @id @default(uuid())
  deckId    String
  version   Int
  /// What the change did, e.g. "Wrote slides 1-4" or "Restored version 3"
  summary   String
  content   Json
  /// The reply that made the change. Null when an officer restored a version from the deck page
  messageId String?
  /// The officer it was made for: whose message started the reply, or who restored it
  userId    String?
  createdAt DateTime @default(now())

  deck    JackDeck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  message JackMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  user    User?        @relation("JackDeckVersionAuthor", fields: [userId], references: [id], onDelete: SetNull)

  @@unique([deckId, version])
  @@index([messageId])
}

// ---------- Recruiting ----------
// Applicants are Users. An Application is one person's submission for a round; it has
// one ApplicationTrack per team they applied to, and decisions are made per track.
// Design: docs/recruiting-system-design.md (local doc).

enum ApplicationState {
  DRAFT // saved on the server, editable, invisible to officers
  SUBMITTED // final: by the applicant, or by the deadline sweep if it was complete
}

enum TrackStatus {
  SUBMITTED // received, not looked at yet
  IN_REVIEW
  INTERVIEW // only for teams that run interviews (enforced in the service layer)
  ACCEPTED
  REJECTED // "not moving forward"
}

model RecruitingCycle {
  id          String    @id @default(uuid())
  slug        String    @unique // "fall-2026"
  name        String
  opensAt     DateTime
  closesAt    DateTime // UTC; shown in America/Chicago
  isActive    Boolean   @default(false) // at most one active round (partial unique index in the migration)
  formVersion Int       @default(1) // bump when a question is removed or changes meaning
  sweptAt     DateTime? // the deadline sweep has been through this closed round cleanly; cleared when closesAt moves
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  applications Application[]
  trackConfigs RecruitingTrackConfig[]
}

model Application {
  id      String           @id @default(uuid())
  cycleId String
  userId  String
  state   ApplicationState @default(DRAFT)

  // Snapshot of profile fields, pre-filled from User and copied here so later profile
  // edits don't change a submitted application. Nullable while it is a draft.
  fullName String?
  email    String?
  eid      String?
  gradYear Int?
  major    String?

  genericAnswers Json    @default("{}") // answers to the generic question set: { questionId: value }
  resumeUrl      String? // https link, required at submit
  portfolioLinks Json    @default("[]") // [{ label, url }], optional, shared across teams
  draftStep      String? // where the applicant left off in the form
  formVersion    Int // copied from the round when the draft is created (no default on purpose)

  submittedAt   DateTime?
  autoSubmitted Boolean   @default(false) // true when the deadline sweep submitted it

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cycle  RecruitingCycle    @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  user   User               @relation("ApplicationApplicant", fields: [userId], references: [id], onDelete: Cascade)
  tracks ApplicationTrack[]
  emails ApplicationEmail[]

  @@unique([cycleId, userId]) // one application per person per round
  @@index([state, cycleId, updatedAt]) // the deadline sweep and officer lists
}

model ApplicationTrack {
  id            String      @id @default(uuid())
  applicationId String
  track         String // key from the hardcoded tracks list, e.g. "racing"
  answers       Json        @default("{}") // this team's page of answers: { questionId: value }
  status        TrackStatus @default(SUBMITTED) // only meaningful once the Application is SUBMITTED
  decidedAt     DateTime?
  decidedById   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  application Application         @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  decidedBy   User?               @relation("ApplicationDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  reviews     ApplicationReview[]
  emails      ApplicationEmail[]

  @@unique([applicationId, track])
  @@index([track, status])
}

model ApplicationReview {
  id                 String   @id @default(uuid())
  applicationTrackId String
  reviewerId         String? // set null if the officer's account is deleted; never blocks account deletion
  score              Int? // 1 to 5, optional
  notes              String?
  createdAt          DateTime @default(now())

  applicationTrack ApplicationTrack @relation(fields: [applicationTrackId], references: [id], onDelete: Cascade)
  reviewer         User?            @relation("ApplicationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([applicationTrackId])
}

// Delivery log for recruiting email. Separate from Notification: that pipeline skips
// users who opted out of marketing mail, and decision emails must always go out.
model ApplicationEmail {
  id                 String             @id @default(uuid())
  applicationId      String
  applicationTrackId String? // null for application-level mail (e.g. "received")
  template           String // RECEIVED | INTERVIEW | ACCEPTED | REJECTED | DEADLINE_REMINDER
  toEmail            String
  subject            String // exactly what was sent
  body               String // exactly what was sent (plain text, before HTML wrapping)
  status             NotificationStatus @default(PENDING)
  resendMessageId    String?
  error              String?
  sentAt             DateTime?
  claimedAt          DateTime? // when the current send was claimed (just before it goes to Resend, and by a resend); an unfinished one is "interrupted" only after a timeout from here
  idempotencyKey     String? // the key the current send uses; a retry after a crash reuses it
  createdAt          DateTime           @default(now())

  application      Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationTrack ApplicationTrack? @relation(fields: [applicationTrackId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([applicationId])
  @@index([resendMessageId])
}

// Per-round, per-team settings (the Google Calendar booking link).
model RecruitingTrackConfig {
  id            String   @id @default(uuid())
  cycleId       String
  track         String
  schedulingUrl String?
  updatedById   String? // plain id, no relation: the audit log records who changed it
  updatedAt     DateTime @updatedAt

  cycle RecruitingCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@unique([cycleId, track])
}

// ---------- Jack 2.0 (#188; design: docs/jack-2/design.md) ----------
// Tables marked "personal data" have row level security with a read policy for jack_readonly only
// (see the migration). Daily tables use the America/Chicago date unless noted.

enum JackProposalStatus {
  PENDING // waiting for an officer
  APPLYING // claimed by an Apply that's running (side effects may have started)
  APPLIED
  DISCARDED
  FAILED
  STALE // what it changes has changed since, or it expired
  SUPERSEDED // a newer proposal for the same thing replaced it
}

/// A change Jack proposed in a room, for an officer to apply or discard (design §4). Personal data:
/// imports carry rows from spreadsheets
model JackProposal {
  id             String             @id @default(uuid())
  roomId         String
  /// The reply that proposed it
  messageId      String?
  /// Registry key, e.g. "event.update" (src/server/jack/proposals)
  kind           String
  /// Written by the kind on the server, never by the model
  title          String
  summary        String
  /// Only the changes, validated by the kind's schema
  payload        Json
  /// What the changed fields were when it was proposed: the diff, and the staleness check
  before         Json?
  /// The card as the kind described it when proposed (ProposalView: diff rows, people, links, rows for
  /// list kinds). Saved because it can't be rebuilt later: the records it describes may have changed
  view           Json?
  /// AuditLog entityType and id of what it changes
  targetType     String?
  targetId       String?
  status         JackProposalStatus @default(PENDING)
  claimedAt      DateTime?
  /// The officer whose message led to it (plain id: audit only)
  proposedForId  String?
  /// Who applied or discarded it (plain id: audit only)
  decidedById    String?
  decidedAt      DateTime?
  /// What applying did (created ids and links, counts, applied rows) or the error, redacted
  result         Json?
  /// After this, a PENDING proposal counts as STALE
  expiresAt      DateTime
  supersededById String?
  /// Proposals built from a room file pin its sha256; Apply checks it
  fileSha256     String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  room JackRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([kind, targetType, targetId, status])
}

enum JackFileKind {
  IMAGE
  PDF
  SPREADSHEET
  CSV
  JSON
  TEXT
  DOCUMENT // .docx
  TRANSCRIPT // .vtt
  OTHER
}

enum JackFileStatus {
  UPLOADING
  READY
  FAILED
}

/// A file an officer attached in a room (design §5). Personal data: sign-in sheets, form exports,
/// transcripts
model JackFile {
  id              String         @id @default(uuid())
  roomId          String
  /// Set when the message that carries it is posted
  messageId       String?
  position        Int            @default(0)
  uploadedById    String?
  filename        String
  contentType     String
  sizeBytes       Int
  /// Where the original is stored (server-chosen: rooms/<roomId>/<id>/<name>)
  storagePath     String         @unique
  sha256          String?
  kind            JackFileKind
  status          JackFileStatus @default(UPLOADING)
  /// The copy Jack looks at (images: JPEG, EXIF stripped, long edge at most 2000 px)
  modelCopyPath   String?
  /// Claude Files API id for the model copy; server-side only, never taken from the browser
  anthropicFileId String?
  thumbPath       String?
  pageCount       Int?
  width           Int?
  height          Int?
  /// Extracted text (capped), for search and for Jack to read
  text            String?
  textStatus      String?
  error           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  room                 JackRoom     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  message              JackMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  meetingsAsTranscript Meeting[]

  @@index([roomId, createdAt])
  @@index([messageId])
  @@index([status, createdAt])
}

enum KnowledgeSource {
  MANUAL // an officer wrote it on the Knowledge page
  JACK // Jack saved it in a room ("not reviewed" until an officer reviews it)
  SEED // loaded from the reviewed seed files
}

/// One piece of club knowledge: a decision, a how-to, a policy, who does what (design §9). Personal
/// data: entries can name people
model KnowledgeEntry {
  id           String          @id @default(uuid())
  title        String
  /// Markdown
  body         String
  tags         String[]        @default([])
  sourceType   KnowledgeSource @default(MANUAL)
  sourceUrl    String?
  /// Where it came from, e.g. "Teams General, Dylan, 9/28"
  sourceNote   String?
  /// When the source said it; with reviewedAt, this dates the entry (not updatedAt)
  sourceDate   DateTime?
  reviewedAt   DateTime?
  reviewedById String?
  /// Room, message and the outside sources read in the reply that saved it (Jack saves only)
  provenance   Json?
  /// Who keeps it current
  ownerId      String?
  createdById  String?
  updatedById  String?
  archivedAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  owner     User?                   @relation("KnowledgeOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  versions  KnowledgeEntryVersion[]
  decisions MeetingDecision[]

  @@index([archivedAt, updatedAt])
  @@index([ownerId])
}

/// Every saved state of a knowledge entry. Personal data, like the entry
model KnowledgeEntryVersion {
  id         String   @id @default(uuid())
  entryId    String
  title      String
  body       String
  tags       String[] @default([])
  editedById String?
  /// "admin" | "jack" | "seed"
  via        String
  roomId     String?
  createdAt  DateTime @default(now())

  entry KnowledgeEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId, createdAt])
}

/// Something that runs on a schedule (design §6). pg_cron's tick calls the site only when a row is
/// due; the dispatcher claims rows with a conditional update on lockedUntil
model ScheduledJob {
  id          String    @id @default(uuid())
  /// e.g. "discord.sync", "digest.weekly", "recurring:<id>"
  key         String    @unique
  /// Job registry key (src/server/scheduler)
  kind        String
  /// Cron expression, evaluated in America/Chicago
  schedule    String
  enabled     Boolean   @default(false)
  config      Json?
  nextRunAt   DateTime
  lockedUntil DateTime?
  lastRunAt   DateTime?
  lastStatus  String?
  /// Redacted
  lastError   String?
  createdById String?
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  runs              ScheduledJobRun[]
  recurringQuestion RecurringQuestion?

  @@index([enabled, nextRunAt])
}

model ScheduledJobRun {
  id         String    @id @default(uuid())
  jobId      String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  /// running | ok | error | skipped
  status     String
  summary    String?
  /// Redacted
  error      String?

  job ScheduledJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, startedAt])
  @@index([startedAt])
}

/// When the scheduler last ran, for the Connections and Scheduled jobs pages
model SchedulerHeartbeat {
  id             String    @id @default("tick")
  lastTickAt     DateTime
  lastDispatchAt DateTime?
}

/// An outside service's switch and sync status (design §12). Never holds credentials: tokens live in
/// env or in SystemSetting, which Jack can't read
model ConnectorState {
  /// Connector id, e.g. "discord"
  id          String    @id
  /// Admins switch connectors on one at a time after their smoke test
  enabled     Boolean   @default(false)
  lastSyncAt  DateTime?
  /// Redacted
  lastError   String?
  lastErrorAt DateTime?
  /// Sync position (page tokens, message ids); never tokens
  cursor      Json?
  updatedAt   DateTime  @updatedAt
}

/// A file from the club's Google Drive folder or SharePoint site, with its text for search (design
/// §12.7 and §12.8). Personal data: documents can hold anything. Deleted files keep the row but lose
/// their text
model ExternalDocument {
  id         String    @id @default(uuid())
  /// "drive" | "sharepoint"
  source     String
  /// Drive file id, or "driveId!itemId" for SharePoint
  externalId String
  driveId    String?
  name       String
  path       String
  mimeType   String
  webUrl     String
  modifiedAt DateTime
  sizeBytes  BigInt?
  /// Drive version or SharePoint eTag, to skip unchanged files
  version    String?
  text       String?
  /// ok | too_large | unsupported | error
  textStatus String
  syncedAt   DateTime
  deletedAt  DateTime?

  meetingsAsTranscript Meeting[]

  @@unique([source, externalId])
  @@index([source, modifiedAt])
}

/// A Teams channel we may sync (off until UT IT approves; design §12.8)
model TeamsChannel {
  id           String    @id
  teamId       String
  name         String
  synced       Boolean   @default(false)
  deltaLink    String?
  lastSyncedAt DateTime?
}

/// A synced Teams channel message. Personal data. Deleted messages lose their content
model TeamsMessage {
  id          String    @id
  channelId   String
  replyToId   String?
  authorAadId String?
  authorName  String
  /// Plain text (HTML stripped)
  content     String
  createdAt   DateTime
  editedAt    DateTime?
  deletedAt   DateTime?

  @@index([channelId, createdAt])
}

/// A Microsoft Graph change-notification subscription (they expire after about 3 days and are renewed)
model GraphSubscription {
  id              String   @id
  resource        String
  expiresAt       DateTime
  clientStateHash String
  createdAt       DateTime @default(now())
}

/// A Discord channel in the club server. Admins choose which ones sync (design §12.1)
model DiscordChannel {
  id            String    @id
  name          String
  type          Int
  parentName    String?
  /// For a thread (types 10, 11): the channel it's in. A thread syncs when that channel does, and its
  /// activity counts toward it. Its name is a member's title, so threads are kept only in opted-in
  /// channels (switching one off deletes them) and never private ones
  parentId      String?
  synced        Boolean   @default(false)
  lastMessageId String?
  lastSyncedAt  DateTime?
  /// Where the trailing re-scan (edits, deletions) starts
  rescanFrom    DateTime?
}

/// Metadata for a message in a synced Discord channel. No message content is stored: Jack searches
/// Discord live. Personal data (who posted when)
model DiscordMessage {
  id            String    @id
  channelId     String
  authorId      String
  /// The linked member, if any (plain id)
  userId        String?
  createdAt     DateTime
  editedAt      DateTime?
  deletedAt     DateTime?
  contentLength Int       @default(0)
  attachments   Int       @default(0)
  isReply       Boolean   @default(false)
  /// Poll question, answers, counts, expiry, finalized (no voters)
  poll          Json?
  lastSeenAt    DateTime

  @@index([channelId, createdAt])
  @@index([authorId, createdAt])
}

/// A member of the club Discord server (for joins, leaves and role sync). Personal data
model DiscordMember {
  id          String    @id
  username    String
  displayName String?
  joinedAt    DateTime?
  roles       String[]  @default([])
  userId      String?
  firstSeenAt DateTime
  lastSeenAt  DateTime
  leftAt      DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model DiscordDailyStat {
  date          DateTime @db.Date
  channelId     String
  messages      Int
  activeAuthors Int

  @@id([date, channelId])
}

model DiscordGuildDaily {
  date        DateTime @id @db.Date
  memberCount Int
  joinedCount Int?
  leftCount   Int?
}

/// A standing automation an officer set up (design §12.1): fixed templates over our own data, never
/// model text. Only acts on items after cutoffAt
model DiscordRule {
  id          String   @id @default(uuid())
  /// event_reminder | new_event | results_posted | standings_update | twitch_live | event_mirror
  kind        String
  channelId   String?
  config      Json
  enabled     Boolean  @default(false)
  cutoffAt    DateTime
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum DiscordPostStatus {
  SCHEDULED
  SENDING
  SENT
  FAILED
  CANCELLED
}

/// A message the bot posts or posted: from a standing rule, an applied proposal, or the admin page
model DiscordPost {
  id               String            @id @default(uuid())
  /// "rule" | "proposal" | "admin"
  source           String
  ruleId           String?
  proposalId       String?
  channelId        String
  /// Exactly what is sent: { content, embeds?, poll?, allowed_mentions }
  content          Json
  /// One post per thing, e.g. "event_reminder:<eventId>:<startsAt>:1440" or "proposal:<id>"
  dedupeKey        String?           @unique
  /// Discord's nonce (enforce_nonce), so a retried send can't post twice
  nonce            String?           @db.VarChar(25)
  status           DiscordPostStatus @default(SCHEDULED)
  scheduledFor     DateTime
  claimedAt        DateTime?
  sentAt           DateTime?
  discordMessageId String?
  /// Redacted
  error            String?
  createdById      String?
  approvedById     String?
  createdAt        DateTime          @default(now())

  @@index([status, scheduledFor])
}

/// Our event mirrored as a Discord scheduled event
model DiscordEventMirror {
  eventId         String   @id
  discordEventId  String   @unique
  /// The start time it was mirrored with, to notice moves
  eventStartsAt   DateTime
  lastSyncedAt    DateTime
  interestedCount Int?
}

/// Which Discord role linked members get, and when (e.g. "officer", "lsc_driver_current_season")
model DiscordRoleRule {
  id          String  @id @default(uuid())
  roleId      String
  condition   String
  enabled     Boolean @default(false)
  createdById String?
}

model TwitchStream {
  id          String    @id
  startedAt   DateTime
  endedAt     DateTime?
  title       String
  gameName    String?
  peakViewers Int       @default(0)
  avgViewers  Float?
  vodId       String?
  vodViews    Int?
  vodViewsAt  DateTime?

  samples TwitchViewerSample[]
}

model TwitchViewerSample {
  streamId String
  at       DateTime
  viewers  Int

  stream TwitchStream @relation(fields: [streamId], references: [id], onDelete: Cascade)

  @@id([streamId, at])
}

model TwitchChannelDaily {
  date      DateTime @id @db.Date
  followers Int?
}

/// EventSub deliveries already handled (design §12.2): Twitch resends a message with the same id, and
/// the webhook processes each id once. Pruned after 2 days by the Twitch token check
model TwitchEventSubMessage {
  /// Twitch-Eventsub-Message-Id
  id         String   @id
  /// notification | revocation
  type       String
  receivedAt DateTime @default(now())

  @@index([receivedAt])
}

/// The Stripe balance once a day (design §12.3)
model StripeBalanceDaily {
  date           DateTime @id @db.Date
  availableCents Int
  pendingCents   Int
  currency       String
}

model StripePayout {
  id          String   @id
  amountCents Int
  currency    String
  status      String
  arrivalDate DateTime
  createdAt   DateTime
  method      String?
  failureCode String?
  syncedAt    DateTime
}

model StripeDispute {
  id              String    @id
  chargeId        String
  paymentIntentId String?
  amountCents     Int
  status          String
  reason          String
  evidenceDueBy   DateTime?
  createdAt       DateTime
  syncedAt        DateTime
}

model StripeRefund {
  id              String   @id
  chargeId        String
  paymentIntentId String?
  amountCents     Int
  status          String
  createdAt       DateTime
  syncedAt        DateTime
}

/// A Stripe charge, synced daily (design §12.3). No card, billing or customer details. paymentIntentId
/// joins Payment.providerRef; feeCents and netCents come from its balance transaction, payoutId from the
/// automatic payout it was paid out in (set once that payout's transactions are listed)
model StripeCharge {
  id                  String   @id
  paymentIntentId     String?
  amountCents         Int
  amountRefundedCents Int      @default(0)
  currency            String
  status              String
  disputed            Boolean  @default(false)
  /// metadata.purpose, e.g. "donation" (donations have no Payment row)
  purpose             String?
  feeCents            Int?
  netCents            Int?
  payoutId            String?
  createdAt           DateTime
  syncedAt            DateTime

  @@index([paymentIntentId])
  @@index([payoutId])
  @@index([createdAt])
}

/// One Resend delivery event for one recipient (design §12.4). Personal data (addresses). Joins to
/// Notification.emailMessageId and ApplicationEmail.resendMessageId. Pruned after 12 months
model EmailEvent {
  id         String   @id @default(uuid())
  resendId   String
  recipient  String
  /// e.g. email.delivered, email.bounced, email.complained, email.opened, email.clicked
  type       String
  occurredAt DateTime
  /// Bounce type and reason, or the clicked link; never IP or user agent
  detail     Json?
  /// Webhook delivery id, so retried deliveries don't count twice
  svixId     String   @unique

  @@index([resendId, occurredAt])
  @@index([recipient, occurredAt])
  @@index([type, occurredAt])
}

/// Site traffic from Vercel Web Analytics, snapshotted daily (Hobby keeps a month). `date` is the UTC
/// day Vercel reports, not the Chicago date
model SiteTrafficDaily {
  date      DateTime @db.Date
  /// "total" | "path" | "referrer" | "country" | "device"
  dimension String
  key       String
  pageviews Int
  visitors  Int

  @@id([date, dimension, key])
}

/// The club Instagram account once a day (account metrics expire after 90 days on Instagram's side)
model InstagramAccountDaily {
  date              DateTime @id @db.Date
  followers         Int
  reach             Int?
  views             Int?
  accountsEngaged   Int?
  totalInteractions Int?
  follows           Int?
  unfollows         Int?
}

/// A publish to Instagram that an officer approved (design §12.6)
model InstagramPublish {
  id           String    @id @default(uuid())
  deckId       String?
  version      Int?
  slideIds     String[]  @default([])
  /// "IMAGE" | "CAROUSEL" | "STORIES"
  mediaType    String
  caption      String
  /// Public JPEG copies on Cloudinary that Instagram fetches
  imageUrls    String[]  @default([])
  /// Containers created so far, saved before media_publish so a retry checks them first
  containerIds Json?
  /// queued | containers | publishing | published | failed
  status       String    @default("queued")
  claimedAt    DateTime?
  igMediaId    String?
  permalink    String?
  /// Redacted
  error        String?
  proposalId   String?   @unique
  createdById  String?
  approvedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

/// A possible sponsor (design §7). Personal data: contact details
model SponsorProspect {
  id            String    @id @default(uuid())
  company       String
  website       String?
  contactName   String?
  contactEmail  String?
  contactRole   String?
  /// idea | researching | contacted | talking | committed | declined | dormant
  stage         String    @default("idea")
  tierInterest  String?
  ownerId       String?
  lastContactAt DateTime?
  nextStep      String?
  nextStepDue   DateTime?
  notes         String?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  owner      User?             @relation("SponsorProspectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  activities SponsorActivity[]

  @@index([stage, updatedAt])
  @@index([ownerId])
}

/// Personal data, like its prospect
model SponsorActivity {
  id         String   @id @default(uuid())
  prospectId String
  /// email_sent | reply | meeting | call | note | stage_change
  type       String
  summary    String
  occurredAt DateTime
  byId       String?
  createdAt  DateTime @default(now())

  prospect SponsorProspect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@index([prospectId, occurredAt])
}

/// A club meeting with its agenda, summary, decisions and action items. Personal data
model Meeting {
  id                   String   @id @default(uuid())
  title                String
  /// board | tech | general | department | other
  kind                 String
  heldAt               DateTime
  agendaMd             String?
  summaryMd            String?
  transcriptFileId     String?
  transcriptDocumentId String?
  roomId               String?
  createdById          String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  transcriptFile     JackFile?         @relation(fields: [transcriptFileId], references: [id], onDelete: SetNull)
  transcriptDocument ExternalDocument? @relation(fields: [transcriptDocumentId], references: [id], onDelete: SetNull)
  room               JackRoom?         @relation(fields: [roomId], references: [id], onDelete: SetNull)
  decisions          MeetingDecision[]
  actionItems        ActionItem[]

  @@index([heldAt])
  @@index([roomId])
  @@index([transcriptFileId])
  @@index([transcriptDocumentId])
}

/// A decision, also kept in the knowledge base's decision log. Personal data
model MeetingDecision {
  id               String   @id @default(uuid())
  meetingId        String?
  text             String
  decidedAt        DateTime
  knowledgeEntryId String?
  createdAt        DateTime @default(now())

  meeting        Meeting?        @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  knowledgeEntry KnowledgeEntry? @relation(fields: [knowledgeEntryId], references: [id], onDelete: SetNull)

  @@index([meetingId])
  @@index([knowledgeEntryId])
}

/// Something someone said they'd do. Personal data
model ActionItem {
  id          String    @id @default(uuid())
  text        String
  ownerId     String?
  dueAt       DateTime?
  /// open | done | dropped
  status      String    @default("open")
  doneAt      DateTime?
  meetingId   String?
  roomId      String?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  owner   User?    @relation("ActionItemOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  meeting Meeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  @@index([status, dueAt])
  @@index([ownerId, status])
  @@index([meetingId])
}

/// A question Jack answers on a schedule in a room (design §11.1). The schedule lives on its
/// ScheduledJob; runs pause when the officer who set it up is no longer an officer
model RecurringQuestion {
  id             String    @id @default(uuid())
  title          String
  prompt         String
  roomId         String
  /// "jack" | "stand"
  persona        String    @default("jack")
  scheduledJobId String    @unique
  /// The officer it runs as
  createdById    String?
  pausedReason   String?
  lastRunAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  room         JackRoom     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  scheduledJob ScheduledJob @relation(fields: [scheduledJobId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("RecurringQuestionCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([roomId])
  @@index([createdById])
}

/// An officer's thumbs up or down on one of Jack's replies
model JackFeedback {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  /// "up" | "down"
  rating    String
  note      String?
  createdAt DateTime @default(now())

  message JackMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
}

/// Full-text search index for Jack 2.0: one row per searchable thing (a room message, knowledge entry,
/// document or Teams message), kept current by database triggers on those tables (see the migration).
/// It's its own table so that no table Jack reads with SELECT * carries a tsvector, which Prisma can't
/// deserialize. Row level security with no policy for jack_readonly: search goes through the tools
model JackSearchDoc {
  /// "room_message" | "knowledge" | "document" | "teams"
  source    String
  sourceId  String
  search    Unsupported("tsvector")?
  updatedAt DateTime                 @default(now())

  @@id([source, sourceId])
  @@index([search], type: Gin)
}
